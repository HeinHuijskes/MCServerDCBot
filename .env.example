# Discord Token
DISCORD_TOKEN=<TOKEN>

# Local RCON
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=<PASSWORD>

# Owner ID
DISCORD_USER_ID=<ID>
# Dev channel id
DISCORD_CHANNEL_ID=<ID>
# MC Player role
DISCORD_ROLE_ID=<ID>
# Dev role
DEV_ROLE_ID=<ID>

# Url that points to Pi, which Nginx can reroute to local squaremap port
MAP_URL=<URL>